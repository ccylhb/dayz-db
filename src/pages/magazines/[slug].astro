---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import entries from "../../data/dayz_magazines.json";
import { cl, pick, desc, stats, introSentence, best } from "../../lib/seo";

export function getStaticPaths() {
  return entries.map((x: any) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props as any;
const f = x.fields || {};
const similar = entries.filter((o: any) => o.slug !== x.slug).slice(0, 6);

// SEO: lead with concrete stats; fall back to the scraped intro sentence.
const description =
  desc(
    `${x.title}:`,
    stats(
      cl(f.capacity) && `${cl(f.capacity)} magazine`,
      pick(f.ammo, f.usedin, f.weapon) && `for ${pick(f.ammo, f.usedin, f.weapon)}`,
      cl(f.size) && `size ${cl(f.size)}`,
      cl(f.weight) && `weight ${cl(f.weight)} g`
    ),
    cl(f.location) && `Loot: ${cl(f.location)}.`,
    "DayZ magazine stats and capacity."
  ) || introSentence(x.intro);
---
<Base
  title=`${x.title} — DayZ magazines stats`
  description={description}
>
  <h1 class="icon-h1">
    {x.icon_file ? <img src={`/icons/${x.icon_file}`} alt={x.title} loading="eager" /> : null}
    <span>{x.title}</span>
  </h1>
  {f.description && <p class="muted">{f.description}</p>}
  <EntryStats entry={x} keys={["capacity", "weapon", "size", "weight", "category"]} labels={{'weapon': 'Used by'}} />
  <p>
    {f.rarity && <span class="tag" style="margin:0.1rem">{f.rarity}</span>}
    {f.location && <span class="tag" style="margin:0.1rem">Loot: {String(f.location).slice(0, 60)}</span>}
    {f.variants && <span class="tag" style="margin:0.1rem">Variants: {f.variants}</span>}
  </p>
  {x.intro && <p>{x.intro}</p>}
  <Related
    links={[
      ...similar.map((s: any) => ({
        href: `/magazines/${s.slug}/`,
        title: s.title,
        sub: `${s.fields?.category || s.template || ""}`,
        icon: s.icon_file ? `/icons/${s.icon_file}` : undefined,
      })),
      { href: "/magazines/", title: "All Magazines", sub: "Sortable table" },
      { href: "/", title: "Home", sub: "All boards" },
    ] as any}
  />
</Base>
