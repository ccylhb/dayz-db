---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import weapons from "../../data/dayz_weapons.json";
import { cl, pick, desc, stats, introSentence, best } from "../../lib/seo";

export function getStaticPaths() {
  return weapons.map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props as any;
const f = x.fields || {};
const similar = weapons
  .filter((o: any) => o.slug !== x.slug && (o.fields?.category || "") === (f.category || ""))
  .slice(0, 6);

// SEO: concrete values only — the old template emitted "?" for every missing field.
const description =
  desc(
    `${x.title}:`,
    cl(f.category) && `${cl(f.category)} —`,
    stats(
      cl(f.mode) && `fire mode ${cl(f.mode)}`,
      cl(f.rateoffire) && `rate of fire ${cl(f.rateoffire)}`,
      cl(f.recoil) && `recoil ${cl(f.recoil)}`,
      cl(f.weight) && `weight ${cl(f.weight)} g`
    ),
    "DayZ weapon stats."
  ) || introSentence(x.intro);
---
<Base
  title={`${x.title} — DayZ weapon stats`}
  description={description}
>
  <h1 class="icon-h1">
    {x.icon_file ? <img src={`/icons/${x.icon_file}`} alt={x.title} loading="eager" /> : null}
    <span>{x.title}</span>
  </h1>
  {f.description && <p class="muted">{f.description}</p>}
  <EntryStats entry={x} keys={["category", "mode", "rateoffire", "recoil", "noise", "ammunition", "magazine", "size", "weight", "zeroing"]} labels={{ mode: "Fire mode", rateoffire: "Rate of fire", ammunition: "Caliber", magazine: "Magazine" }} />
  <p>
    {f.rarity && <span class="tag" style="margin:0.1rem">{f.rarity}</span>}
    {f.location && <span class="tag" style="margin:0.1rem">Loot: {String(f.location).slice(0, 60)}</span>}
    {f.variants && <span class="tag" style="margin:0.1rem">Variants: {f.variants}</span>}
  </p>
  {x.intro && <p>{x.intro}</p>}
  <Related
    links={[
      ...similar.map((s: any) => ({
        href: `/weapons/${s.slug}/`,
        title: s.title,
        sub: `${s.fields?.category || ""} · ${s.fields?.mode || ""}`,
        icon: s.icon_file ? `/icons/${s.icon_file}` : undefined,
      })),
      { href: "/weapons/", title: "All Weapons", sub: "Sortable table" },
      { href: "/ammo/", title: "Ammo Damage", sub: "Per-caliber damage" },
    ]}
  />
</Base>
